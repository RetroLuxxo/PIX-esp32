            .then(redes => {
                document.getElementById('ssid-label').textContent = '-- Selecione a rede --';
                redes.sort((a,b) => b.rssi - a.rssi);
                list.innerHTML = '';
                redes.forEach(r => {
                    const bars = r.rssi > -60 ? '|||' : r.rssi > -75 ? '||.' : '|..';
                    const div = document.createElement('div');
                    div.textContent = r.ssid + '  ' + bars + ' (' + r.rssi + 'dBm)';
                    div.style.cssText = 'padding:10px;color:#fff;cursor:pointer;border-bottom:1px solid #444;';
