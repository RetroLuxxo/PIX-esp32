void handleSave() {
    DBG_LOG("🚨 Recebendo dados de configuração via Web AP...");
    
    if (server.hasArg("ssid") && server.hasArg("password") && server.hasArg("token") && 
        server.hasArg("posid") && server.hasArg("valor") && server.hasArg("tempoRele") && 
        server.hasArg("storeName")) {
        
        String ssid = server.arg("ssid");
        ssid.toCharArray(configMaquina.wifiSsid, sizeof(configMaquina.wifiSsid));
        
        String pass = server.arg("password");
        pass.toCharArray(configMaquina.wifiPassword, sizeof(configMaquina.wifiPassword));
        
        String token = server.arg("token");
        token.toCharArray(configMaquina.mpAccessToken, sizeof(configMaquina.mpAccessToken));

        String posid = server.arg("posid");
        posid.toCharArray(configMaquina.mpExternalPosId, sizeof(configMaquina.mpExternalPosId));

        String storeName = server.arg("storeName"); 
        storeName.toCharArray(configMaquina.storeName, sizeof(configMaquina.storeName));

        configMaquina.valorProduto = server.arg("valor").toFloat();
        configMaquina.tempoReleMs = server.arg("tempoRele").toInt();
        
        // Validações
        if (configMaquina.valorProduto < 0.01f) {
           configMaquina.valorProduto = 1.00f; 
        }
        
        if (configMaquina.tempoReleMs < 100 || configMaquina.tempoReleMs > 5000) {
           configMaquina.tempoReleMs = 300;
        }

        if (String(configMaquina.mpAccessToken).length() < 10) {
            DBG_LOG("❌ ERRO: Access Token do Mercado Pago muito curto. Configuração não salva.");
            server.send(500, "text/plain", "ERRO: Access Token muito curto. Tente novamente.");
            return;
        }

        salvarConfig();
        DBG_LOG("✅ CONFIGURAÇÃO RECEBIDA E SALVA! O sistema irá reiniciar em 5 segundos.");
        
        String response = "<h1>Configura&ccedil;&otilde;es Salvas!</h1><p>O sistema ir&aacute; reiniciar em instantes para aplicar as novas configura&ccedil;&otilde;es.</p>";
        server.send(200, "text/html", response);
        
        delay(5000);
        ESP.restart();

    } else {
        DBG_LOG("❌ Erro: Dados POST incompletos.");
        server.send(400, "text/plain", "Erro: Dados incompletos no formulário.");
    }
}

void salvarConfig() {
    File arquivo = SPIFFS.open("/config.json", "w");
    if (arquivo) {
        StaticJsonDocument<1024> doc; 
        doc["wifiSsid"] = configMaquina.wifiSsid;
        doc["wifiPassword"] = configMaquina.wifiPassword;
        doc["mpAccessToken"] = configMaquina.mpAccessToken;
        doc["mpExternalPosId"] = configMaquina.mpExternalPosId;
        doc["storeName"] = configMaquina.storeName; 
        doc["valorProduto"] = configMaquina.valorProduto;
        doc["tempoReleMs"] = configMaquina.tempoReleMs;
        serializeJson(doc, arquivo);
        arquivo.close();
        DBG_LOG("✅ Configuração salva no SPIFFS!");
    }
}

void carregarConfig() {
    // Configuração padrão de fallback
    strlcpy(configMaquina.wifiSsid, "", sizeof(configMaquina.wifiSsid));
    strlcpy(configMaquina.wifiPassword, "", sizeof(configMaquina.wifiPassword));
    strlcpy(configMaquina.mpAccessToken, "", sizeof(configMaquina.mpAccessToken));
    strlcpy(configMaquina.mpExternalPosId, "MAQUINA01", sizeof(configMaquina.mpExternalPosId));
    strlcpy(configMaquina.storeName, "MINHA LOJA", sizeof(configMaquina.storeName));
    configMaquina.valorProduto = 1.00f; 
    configMaquina.tempoReleMs = 300;
    
    if (SPIFFS.exists("/config.json")) {
        File arquivo = SPIFFS.open("/config.json", "r");
        if (arquivo) {
            StaticJsonDocument<1024> doc;
            DeserializationError error = deserializeJson(doc, arquivo);
        
            if (!error) {
                strlcpy(configMaquina.wifiSsid, doc["wifiSsid"] | "", sizeof(configMaquina.wifiSsid));
                strlcpy(configMaquina.wifiPassword, doc["wifiPassword"] | "", sizeof(configMaquina.wifiPassword));
                strlcpy(configMaquina.mpAccessToken, doc["mpAccessToken"] | "", sizeof(configMaquina.mpAccessToken));
                strlcpy(configMaquina.mpExternalPosId, doc["mpExternalPosId"] | "MAQUINA01", sizeof(configMaquina.mpExternalPosId));
                strlcpy(configMaquina.storeName, doc["storeName"] | "MINHA LOJA", sizeof(configMaquina.storeName)); 
                configMaquina.valorProduto = doc["valorProduto"] | 1.00f;
                configMaquina.tempoReleMs = doc["tempoReleMs"] | 300;
                DBG_LOG("✅ Configuração carregada do SPIFFS");
            } else {
                DBG_LOG("❌ Erro ao ler JSON de configuração: " + String(error.c_str()));
            }
            arquivo.close();
        }
    }
}

// ===================================
// --- FUNÇÕES SERIAL (OPERAÇÃO) ---
// ===================================

void processarComandoSerial() {
    if (!Serial.available()) return;
    
    String comando = Serial.readStringUntil('\n');
    comando.trim();
    
    while(Serial.available()) Serial.read(); 
    
    String comandoUpper = comando;
    comandoUpper.toUpperCase();

    // COMANDO: ZERAR CONFIGURAÇÃO
    if (comandoUpper == "RESETWIFI") {
        DBG_LOG("🚨 COMANDO MANUAL: ZERANDO TODAS as configurações.");
        exibirMensagem(" ZERANDO   DADOS...", ST77XX_RED);
        WiFi.disconnect(true);
        if (SPIFFS.exists("/config.json")) {
            SPIFFS.remove("/config.json");
        }
        DBG_LOG("🔄 Reiniciando em 3 segundos...");
        delay(3000);
        ESP.restart();
        return; 
    }
    
    // COMANDO: INICIAR VENDA/GERAR PIX (Simula um clique)
    if (estadoAtual == EM_ESPERA) {
        if (comandoUpper == "INICIAR" || comandoUpper == "GO") {
            DBG_LOG("🚨 COMANDO MANUAL: Iniciando contagem de venda via Serial.");
            valorAcumulado = configMaquina.valorProduto;
            estadoAtual = CONTANDO_PRODUTOS;
            exibirTelaContagem();
            lastInteractionTime = millis();
            return;
        }
    }
    
    // COMANDO: CONFIRMAR PAGAMENTO (Simula aprovação)
    if (estadoAtual == AGUARDANDO_PAGAMENTO && (comandoUpper == "PAGO" || comandoUpper == "CONFIRMAR")) {
        DBG_LOG("🚨 COMANDO MANUAL: Forçando verificação de pagamento (PAGO).");
        
        // Em um ambiente de teste, podemos simular o valor pago para o pagamento
        // valorPagoPix = valorAcumulado; // Descomente para teste simples: paga o que foi pedido
        
        // Em produção, a linha abaixo deve ser usada para obter o valor real
        valorPagoPix = verificarValorPagoMercadoPago(paymentId);
        
        if (valorPagoPix >= valorAcumulado) {
            DBG_LOG("✅ Pagamento APROVADO via comando manual. Valor Pago: R$" + String(valorPagoPix, 2));
            estadoAtual = LIBERANDO_PRODUTO; // <<< Transição Direta para a Liberação
            exibirTelaPagamentoRecebido();
        } else {
            DBG_LOG("❌ Pagamento não detectado ou valor pago insuficiente. Cancelando venda.");
            exibirMensagem("PAGAMENTO   FALHOU", ST77XX_RED);
            delay(3000);
            valorAcumulado = 0.00f;
            estadoAtual = EM_ESPERA;
            exibirTelaInicial();
        }
        return;
    }

    // COMANDO: IR PARA PIX
    if (estadoAtual == CONTANDO_PRODUTOS && (comandoUpper == "PIX" || comandoUpper == "PAGAR")) {
        DBG_LOG("🚨 COMANDO MANUAL: Forçando geração do PIX com valor R$" + String(valorAcumulado, 2));
        estadoAtual = GERANDO_PIX;
        exibirMensagem(" GERANDO   QR CODE!", ST77XX_YELLOW);
        return;
    }
    
    if (estadoAtual != MODO_AP_CONFIG && !comando.isEmpty() && !comandoUpper.startsWith("CREDIT=")) {
        DBG_LOG("ℹ️ Comando Serial recebido (Nao reconhecido neste estado): " + comando);
    }
}

