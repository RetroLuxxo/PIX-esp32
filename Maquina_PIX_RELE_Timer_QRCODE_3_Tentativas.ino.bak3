void conectarWiFi() {
    if (String(configMaquina.wifiSsid).length() == 0 || String(configMaquina.mpAccessToken).length() < 10) {
        DBG_LOG("❌ Configuração incompleta. Entrando no MODO CONFIG AP.");
        entrarModoConfigAP();
        return;
    }
    
    DBG_LOG("📡 Tentando conectar a WiFi: " + String(configMaquina.wifiSsid));
    //exibirMensagem("CONECTANDO  WI-FI...", ST77XX_YELLOW);
    
    WiFi.mode(WIFI_STA);  
    WiFi.begin(configMaquina.wifiSsid, configMaquina.wifiPassword);
    

    while (WiFi.status() != WL_CONNECTED && tentativas < maxTentativas) {
    tentativas++;
    Serial.print("Tentativa ");
    Serial.print(tentativas);
    Serial.println(" de 3...");

    exibirMensagem("CONECTANDO  WI-FI...", ST77XX_YELLOW);
    //tft.fillScreen(ST77XX_BLACK);
    tft.setCursor(10, 90);
    tft.setTextColor(ST77XX_YELLOW);
    tft.setTextSize(2);
    tft.println(String(tentativas) + " de 3...");

    WiFi.begin(configMaquina.wifiSsid, configMaquina.wifiPassword);
    
    // Aguarda até 15 segundos por tentativa
    unsigned long start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 15000) {
    delay(500);
    Serial.print(".");
    }
    Serial.println("");
  }

  // Verificação final
if (WiFi.status() == WL_CONNECTED) {
        DBG_LOG("\n✅ WiFi Conectado! IP: " + WiFi.localIP().toString());
        estadoAtual = EM_ESPERA;
        exibirTelaInicial();
    } else {
        DBG_LOG("\n❌ Falha na conexão WiFi.");
        tft.fillScreen(ST77XX_RED);
        tft.setCursor(40, 25);
        tft.setTextColor(ST77XX_WHITE);
        tft.setTextSize(2);
        tft.println("FORA");
        tft.setCursor(52, 50);
        tft.println("DE");
        tft.setCursor(22, 75);
        tft.println("SERVICO");
        tft.drawFastHLine(0, 110, tft.width(), ST77XX_WHITE); // LINHA
        tft.setCursor(12, 130);
        tft.setTextSize(1);
        tft.println("SEM CONEXAO WI-FI");

        delay (3000);

        entrarModoConfigAP();
        // conectarWiFi();
        //estadoAtual = EM_ESPERA;
    }
}
   
    

const char* mp_host = "api.mercadopago.com";

// Cancela uma cobrança PIX no Mercado Pago (status → cancelled)
// Isso invalida o QR Code e impede pagamento após cancelamento manual.
bool cancelarCobrancaMercadoPago(String id) {
    if (id.isEmpty()) return false;

    DBG_LOG("🚫 Cancelando cobrança PIX id=" + id + " no Mercado Pago...");

    String url = "https://" + String(mp_host) + "/v1/payments/" + id;
    WiFiClientSecure client;
    client.setInsecure();

    HTTPClient http;
    http.begin(client, url);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("Authorization", "Bearer " + String(configMaquina.mpAccessToken));

    // A API do MP usa PUT com status=cancelled para cancelar
    int httpCode = http.PUT("{\"status\":\"cancelled\"}");

    bool sucesso = (httpCode == 200);
    if (sucesso) {
        DBG_LOG("✅ Cobrança cancelada com sucesso no Mercado Pago.");
    } else {
        DBG_LOG("⚠️ Falha ao cancelar cobrança (HTTP " + String(httpCode) + "). QR pode ainda estar ativo.");
    }

    http.end();
    return sucesso;
}

String criarCobrancaPixMercadoPago(float valor) {
    DBG_LOG("💳 Criando PIX via MP API para R$" + String(valor, 2));
    
    valorPagoPix = 0.00f; 
    
    if (String(configMaquina.mpAccessToken).length() < 10) {
        exibirMensagem("  ERRO:    TOKEN MP", ST77XX_RED);
        return "";
    }
    
    String uniqueID = String(millis());
    String externalReference = String(configMaquina.mpExternalPosId) + "-" + uniqueID;
    
    String url = "https://" + String(mp_host) + "/v1/payments";
    WiFiClientSecure client;
    client.setInsecure(); 
    
    HTTPClient http;
    http.begin(client, url);

    http.addHeader("Content-Type", "application/json");
    http.addHeader("Authorization", "Bearer " + String(configMaquina.mpAccessToken));
    http.addHeader("X-Idempotency-Key", externalReference);
    
    StaticJsonDocument<1024> reqDoc;

    reqDoc["transaction_amount"] = valor; 
    
    // USANDO O NOME DA LOJA NA DESCRIÇÃO
    reqDoc["description"] = "Venda " + String(configMaquina.storeName) + " - ID: " + String(configMaquina.mpExternalPosId); 

    reqDoc["payment_method_id"] = "pix";
    reqDoc["installments"] = 1;
    reqDoc["external_reference"] = externalReference; 
    
    JsonObject payer = reqDoc.createNestedObject("payer");
    payer["email"] = "pix@maquinavenda.com";
    payer["first_name"] = configMaquina.mpExternalPosId;
    payer["last_name"] = "VENDING";
    
    String requestBody;
    serializeJson(reqDoc, requestBody);
    
    int httpResponseCode = http.POST(requestBody);

    if (httpResponseCode > 0) {
        String payload = http.getString();
        if (httpResponseCode == 201) { 
            StaticJsonDocument<1024> respDoc;
            DeserializationError error = deserializeJson(respDoc, payload);

            if (!error) {
                paymentId = respDoc["id"].as<String>();
                String qrCodePayload = respDoc["point_of_interaction"]["transaction_data"]["qr_code"].as<String>();
                
                http.end();
                if (!qrCodePayload.isEmpty()) {
                    return qrCodePayload;
                }
            } 
        } 
    }
    
    http.end();
    return "";
}

float verificarValorPagoMercadoPago(String id) {
    if (id.isEmpty()) return 0.00f;
    
    String url = "https://" + String(mp_host) + "/v1/payments/" + id;
    WiFiClientSecure client;
    client.setInsecure();
    
    HTTPClient http;
    http.begin(client, url);

    http.addHeader("Authorization", "Bearer " + String(configMaquina.mpAccessToken));

    int httpResponseCode = http.GET();
    float paidAmount = 0.00f;  

    if (httpResponseCode == 200) {  
        String payload = http.getString();
        StaticJsonDocument<1024> doc; 
        DeserializationError error = deserializeJson(doc, payload);

        if (!error) {
            String status = doc["status"].as<String>();

            if (status == "approved") {
                paidAmount = doc["transaction_amount"] | 0.00f; 
            }
        } 
    } 
    
    http.end();
    
    return paidAmount;
}

// ===================================
// --- SETUP E LOOP ---
// ===================================

void setup() {
    Serial.begin(115200);
    Serial.setTimeout(50);
    
    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, HIGH);
    pinMode(BUTTON_PIN, INPUT_PULLUP);
    pinMode(LED_PIN, OUTPUT);
    digitalWrite(LED_PIN, LOW);


    tft.initR(INITR_BLACKTAB); 
    tft.setRotation(0);
    tft.fillScreen(ST77XX_BLACK);
    
    if (!SPIFFS.begin(true)) {
        DBG_LOG("❌ Erro SPIFFS.");
        return;
    }
    
    // CHECAGEM DE BOTÃO NA INICIALIZAÇÃO (MODO CONFIG AP)
    if (digitalRead(BUTTON_PIN) == LOW) {
        unsigned long startTime = millis();
        exibirMensagem("CONFIGURAR   (5s)", ST77XX_YELLOW); 

        while (digitalRead(BUTTON_PIN) == LOW && millis() - startTime < 5000) {  
            int progress = map(millis() - startTime, 0, 5000, 0, 100);
            tft.setCursor(10, 85);
            tft.setTextColor(ST77XX_CYAN);
            tft.print("Segure para Config   ");
            tft.print(String(progress) + "%");
            tft.print(" ");  
            delay(50);
        }
        
        if (millis() - startTime >= 5000) {
            carregarConfig(); 
            entrarModoConfigAP();
            return; 
        } else {
            exibirMensagem("INICIANDO!", ST77XX_WHITE);
        }
    }

    carregarConfig();
    conectarWiFi();
}

void loop() {

    
    if (estadoAtual == MODO_AP_CONFIG) {
        server.handleClient();
        delay(10);
        return;
    }
    
    processarComandoSerial();
    
    static unsigned long lastCheckTime = 0;
    const long checkInterval = 5000;
    unsigned long currentTime = millis();
    
    // Lógica do Botão: Iniciar Compra ou Somar Valor
    if (digitalRead(BUTTON_PIN) == LOW && (currentTime - lastButtonPressTime) > DEBOUNCE_DELAY) {
        delay(DEBOUNCE_DELAY);
        if (digitalRead(BUTTON_PIN) == LOW) {
            
            if (estadoAtual == EM_ESPERA) {
                // Inicia nova transação
                valorAcumulado = configMaquina.valorProduto;
                DBG_LOG("🚨 Botão: Início de compra. Custo inicial: R$" + String(valorAcumulado, 2));
                estadoAtual = CONTANDO_PRODUTOS;
            
            } else if (estadoAtual == CONTANDO_PRODUTOS) {
                // SOMA O VALOR FIXO
                valorAcumulado += configMaquina.valorProduto; 
                DBG_LOG("🚨 Botão: Somou valor. Novo PIX de R$" + String(valorAcumulado, 2));
            
            } else if (estadoAtual == AGUARDANDO_PAGAMENTO) {
                // CANCELAMENTO MANUAL — verifica pagamento antes de cancelar
                // Cenario: cliente A escaneou e pagou, cliente B apertou cancelar ao mesmo tempo.
                DBG_LOG("\u26a0\ufe0f Bot\u00e3o: Tentativa de cancelamento. Verificando se ja houve pagamento...");
                exibirMensagem("VERIFICAND ...", ST77XX_YELLOW);

                float valorVerificado = verificarValorPagoMercadoPago(paymentId);

                if (valorVerificado >= valorAcumulado) {
                    // Pagamento ja foi confirmado - libera o produto, nao cancela
                    DBG_LOG("\u2705 Pagamento detectado no cancelamento! Valor: R$" + String(valorVerificado, 2) + " - Liberando produto.");
                    valorPagoPix = valorVerificado;
                    estadoAtual = LIBERANDO_PRODUTO;
                    exibirTelaPagamentoRecebido();
                } else {
                    // Nao ha pagamento - cancela a cobrança no MP e volta ao início
                    DBG_LOG("\u274c Sem pagamento. Cancelando cobrança no Mercado Pago...");
                    exibirMensagem("CANCELANDO ...", ST77XX_YELLOW);
                    cancelarCobrancaMercadoPago(paymentId); // Invalida o QR Code no servidor
                    paymentId = "";
                    pixPayload = "";
                    exibirMensagem("  VENDA    CANCELADA", ST77XX_YELLOW);
                    delay(2000);
                    valorAcumulado = 0.00f;
                    estadoAtual = EM_ESPERA;
                    exibirTelaInicial();
                }
                
            }
            
            lastButtonPressTime = currentTime;
            lastInteractionTime = currentTime;
            
            if (estadoAtual == CONTANDO_PRODUTOS) {
                exibirTelaContagem();
            }
        }
    }

// 
    while (digitalRead(BUTTON_PIN) == LOW) { 
    delay(10); 
  }


    // Máquina de estados principal
    switch (estadoAtual) {
        
        case EM_ESPERA:
            if (currentTime % 1000 < 500) {
                digitalWrite(LED_PIN, HIGH);
            } else {
                digitalWrite(LED_PIN, LOW);
            }
            break;

        case CONTANDO_PRODUTOS: {
            // Lógica de Timeout (Vai para GERANDO_PIX)
            if ((currentTime - lastInteractionTime) >= INACTIVITY_TIMEOUT) {
                DBG_LOG("⏰ Timeout de inatividade (" + String(INACTIVITY_TIMEOUT/1000) + "s). Gerando PIX para R$" + String(valorAcumulado, 2));
                estadoAtual = GERANDO_PIX;
                exibirMensagem(" GERANDO   QR CODE!", ST77XX_YELLOW);
            }
            digitalWrite(LED_PIN, LOW);
            break;
        }

        case GERANDO_PIX:
            pixPayload = criarCobrancaPixMercadoPago(valorAcumulado);
            
            if (!pixPayload.isEmpty()) {
                qrcode_initText(&qrcode, qrcodeData, QR_VERSION, QR_ECC_LEVEL, pixPayload.c_str());
                drawQRCode(START_X, START_Y, QR_SCALE, valorAcumulado);                
                pixStartTime = currentTime; // Inicia o timer
                lastCheckTime = currentTime; // Inicia a primeira checagem
                estadoAtual = AGUARDANDO_PAGAMENTO;
                digitalWrite(LED_PIN, LOW);
            } else {
                DBG_LOG("❌ Falha ao gerar PIX. Voltando para EM_ESPERA.");
                exibirMensagem("  ERRO      PIX...", ST77XX_RED);
                delay(2000);
                valorAcumulado = 0.00f;
                estadoAtual = EM_ESPERA;
                exibirTelaInicial();
            }
            break;

        case AGUARDANDO_PAGAMENTO:

        atualizarTimer(); //TESTE CRONOMETRO ABAIXO DO QR CODE - RICK ---

            // 1. PRIMEIRO: Verificação de Pagamento (a cada 5s)
            // Garante que mesmo no último instante antes do timeout,
            // um pagamento aprovado seja sempre processado.
            if ((currentTime - lastCheckTime) >= checkInterval) {
                lastCheckTime = currentTime;
                valorPagoPix = verificarValorPagoMercadoPago(paymentId);
                
                if (valorPagoPix >= valorAcumulado) {
                    DBG_LOG("✅ Pagamento APROVADO! Valor Pago: R$" + String(valorPagoPix, 2));
                    
                    // TRANSICAO AUTOMATICA
                    estadoAtual = LIBERANDO_PRODUTO;
                    exibirTelaPagamentoRecebido();
                    break; // Sai imediatamente — não verifica timeout
                } else if (valorPagoPix > 0.00f && valorPagoPix < valorAcumulado) {
                    DBG_LOG("❌ Pagamento INSUFICIENTE. Cancelando.");
                    exibirMensagem("PAGAMENTO INSUFIC...", ST77XX_RED);
                    delay(3000);
                    valorAcumulado = 0.00f;
                    estadoAtual = EM_ESPERA;
                    exibirTelaInicial();
                    break;
                } else {
                    DBG_LOG_FAST("🔄 Aguardando pagamento...");
                }
            }

            // 2. DEPOIS: Lógica de Timeout do QR
            // Só cancela se o pagamento não foi confirmado acima.
            if ((currentTime - pixStartTime) >= QR_TIMEOUT_MS) {
                DBG_LOG("⏰ Timeout do QR Code. Cancelando transação.");
                exibirMensagem("  TEMPO    ESGOTADO", ST77XX_RED);

                DBG_LOG("\u274c Tempo Esgotado. Cancelando cobrança no Mercado Pago...");
                cancelarCobrancaMercadoPago(paymentId); // Invalida o QR Code no servidor
                paymentId = "";
                pixPayload = "";
                exibirMensagem("  VENDA    CANCELADA", ST77XX_YELLOW);

                delay(2000);
                valorAcumulado = 0.00f;
                estadoAtual = EM_ESPERA;
                exibirTelaInicial();
                break;
            }
            
            if (currentTime % 500 < 250) {
                digitalWrite(LED_PIN, HIGH);
            } else {
                digitalWrite(LED_PIN, LOW);
            }
            break;

        // --- ESTADO: LIBERANDO PRODUTO (ACIONALMENTO MÚLTIPLO DO RELÉ AUTOMÁTICO SEM CRÉDITO) ---
        case LIBERANDO_PRODUTO: { 
            digitalWrite(LED_PIN, HIGH);

            // 1. Calcula o número de CRÉDITOS baseado no VALOR REAL PAGO
            int numCreditos = (configMaquina.valorProduto > 0) ? floor(valorPagoPix / configMaquina.valorProduto) : 0;
            
            DBG_LOG("------------------------------------------------------------------");
            DBG_LOG("⚙️ Liberação Automática:");
            DBG_LOG(" Valor Pago (Base para créditos): R$" + String(valorPagoPix, 2)); // ALTERADO
            DBG_LOG(" Créditos a serem liberados: " + String(numCreditos)); // ALTERADO
            DBG_LOG("------------------------------------------------------------------");
            
            if (numCreditos > 0) {
                // 2. Acionamento Múltiplo do Relé
                exibirMensagem(("LIBERANDO     " + String(numCreditos) + "      CREDITOS").c_str(), ST77XX_YELLOW); // ALTERADO
                delay(1000); 

                for (int i = 0; i < numCreditos; i++) {
                    DBG_LOG("⚙️ Crédito " + String(i + 1) + " de " + String(numCreditos) + "..."); // ALTERADO
                    digitalWrite(RELAY_PIN, LOW); // LIGA o relé (Ativo Baixo)
                    delay(configMaquina.tempoReleMs);
                    digitalWrite(RELAY_PIN, HIGH); // DESLIGA o RELE
                    if (i < numCreditos - 1) {
                        delay(configMaquina.tempoReleMs / 2); // Intervalo entre créditos
                    }
                }
                DBG_LOG("⚙️ Relés Finalizados. Transação concluída.");
                exibirTelaProdutoLiberado(); 
            } else {
                 DBG_LOG("⚠️ Zero créditos liberados. Verifique valor unitário."); // ALTERADO
            }

            // 3. Limpeza de variáveis de transação
            valorAcumulado = 0.00f;
            valorPagoPix = 0.00f;
            paymentId = "";
            pixPayload = "";
            delay(3000);

            // 4. Transição de estado: SEMPRE volta para EM_ESPERA
            estadoAtual = EM_ESPERA;
            exibirTelaInicial();
            digitalWrite(LED_PIN, LOW);
            break;
        }

        case MODO_AP_CONFIG:
            // Já é tratado no início do loop
            break;
    }
    delay(10);
}