void drawQRCode(int x, int y, int scale, float valorExibido) {
    tft.fillScreen(COLOR_WHITE);

    tft.setCursor(13, 2);
    tft.setTextColor(ST77XX_RED);
    tft.setTextSize(1);
    tft.println("CLIQUE P CANCELAR");
    
    for (uint8_t qy = 0; qy < qrcode.size; qy++) {
        for (uint8_t qx = 0; qx < qrcode.size; qx++) {
            int block_x = x + qx * scale;
            int block_y = y + qy * scale;
            if (qrcode_getModule(&qrcode, qx, qy)) {
                tft.fillRect(block_x, block_y, scale, scale, COLOR_BLACK);
            } else {
                tft.fillRect(block_x, block_y, scale, scale, COLOR_WHITE);
            }
            yield();
        }
    }
    
    int qr_end_y = y + qrcode.size * scale; 
    
    tft.setCursor(3, qr_end_y + 8);
    tft.setTextColor(ST77XX_BLACK);
    tft.setTextSize(2);
    tft.print("R$");
    tft.print(String(valorExibido, 2));
    
    tempoInicial = millis(); // --- TESTE CRONOMETRO ABAIXO DO QR CODE - RICK --- Inicia a contagem
    }

    //TESTE CRONOMETRO ABAIXO DO QR CODE - RICK ---
    void atualizarTimer() {
    unsigned long millisAtuais = millis();
    unsigned long tempoPassado = (millisAtuais - tempoInicial) / 1000;

    if (tempoPassado <= duracaoSegundos) {
        int tempoRestante = duracaoSegundos - tempoPassado;
        int minutos = tempoRestante / 60;
        int segundos = tempoRestante % 60;

        // Atualiza apenas se o segundo mudou
        if (segundos != ultimoSegundoRegistrado) {
            ultimoSegundoRegistrado = segundos;

            // Apaga apenas a área do tempo (X=80, Y=140, Largura=45, Altura=10)
            tft.fillRect(95, 151, 33, 9, ST77XX_BLACK);
            tft.setCursor(97, 152);
            tft.setTextColor(ST77XX_GREEN);
            tft.setTextSize(1);
            tft.printf("%02d:%02d", minutos, segundos);
        }
    } else {
        // // Ação após os 3 minutos
        // tft.fillScreen(ST77XX_BLACK);
        // tft.setCursor(20, 80);
        // tft.print("QR Code Expirado");
    }
    }
