// ===================================
// --- FUNÇÕES DE CONFIGURAÇÃO VIA AP ---
// ===================================

void entrarModoConfigAP() {
    estadoAtual = MODO_AP_CONFIG;
    DBG_LOG("📡 MODO CONFIGURAÇÃO AP: Inicializando Access Point...");
    
    WiFi.disconnect(true);
    WiFi.mode(WIFI_AP_STA);

    tft.fillScreen(ST77XX_BLUE);
    tft.setCursor(5, 15);
    tft.setTextColor(ST77XX_YELLOW);
    tft.setTextSize(2);
    tft.println("CONFIG AP:");
    tft.drawFastHLine(0, 40, tft.width(), ST77XX_WHITE);
    tft.setCursor(5, 80);
    tft.setTextColor(ST77XX_WHITE);
    tft.setTextSize(1);
    tft.println(ap_ssid);
    tft.setCursor(5, 120);
    tft.setTextColor(ST77XX_YELLOW);
    tft.println("Acesse 192.168.4.1");
    
    WiFi.softAPConfig(local_ip, gateway, subnet);
    WiFi.softAP(ap_ssid, ap_password);
    
    int n = WiFi.scanNetworks();
    redesDisponiveis = "[";
    for (int i = 0; i < n; i++) {
        if (i > 0) redesDisponiveis += ",";
        redesDisponiveis += "{\"ssid\":\"" + WiFi.SSID(i) + "\",\"rssi\":" + String(WiFi.RSSI(i)) + "}";
    }
    redesDisponiveis += "]";
    server.on("/", HTTP_GET, handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.on("/scan", HTTP_GET, handleScan);
    server.onNotFound(handleRoot); 

    server.begin();
}

void handleScan() {
    server.send(200, "application/json", redesDisponiveis);
}

void handleRoot() {
    String html = R"rawliteral(
